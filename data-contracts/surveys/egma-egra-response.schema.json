{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fundacion-luker.org/schemas/surveys/egma-egra-response.schema.json",
  "title": "EGMA/EGRA Survey Response",
  "type": "object",
  "required": [
    "instrument_code",
    "instrument_version",
    "student",
    "assessor",
    "session",
    "responses"
  ],
  "properties": {
    "instrument_code": {
      "type": "string",
      "enum": ["EGMA", "EGRA"]
    },
    "instrument_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "student": {
      "type": "object",
      "required": ["document_type", "document_number", "full_name"],
      "properties": {
        "document_type": {
          "type": "string",
          "enum": ["TI", "CE", "NES", "PEP", "PPT", "RC", "VISA"]
        },
        "document_number": { "type": "string", "minLength": 3 },
        "full_name": { "type": "string", "minLength": 3 },
        "gender": { "type": "string", "enum": ["FEMENINO", "MASCULINO", "OTRO", "NO_REPORTA"] },
        "institution": { "type": "string" },
        "campus": { "type": "string" },
        "grade": { "type": "string" },
        "group": { "type": "string" },
        "shift": { "type": "string", "enum": ["MANANA", "TARDE", "UNICA"] },
        "location": { "type": "string", "enum": ["URBANA", "RURAL"] },
        "birth_date": { "type": "string", "format": "date" },
        "age": { "type": "integer", "minimum": 3, "maximum": 25 },
        "record_origin": { "type": "string", "enum": ["PRECARGADO", "NUEVO"] }
      },
      "additionalProperties": false
    },
    "assessor": {
      "type": "object",
      "required": ["assessor_id", "assessor_name"],
      "properties": {
        "assessor_id": { "type": "string" },
        "assessor_name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["started_at", "ended_at", "device_id", "sync_status"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "device_id": { "type": "string" },
        "sync_status": { "type": "string", "enum": ["PENDING", "SYNCED", "FAILED"] },
        "offline_captured": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_code", "response_status"],
        "properties": {
          "item_code": { "type": "string" },
          "response_status": { "type": "string", "enum": ["CORRECTO", "INCORRECTO", "NO_RESPONDE", "RESPUESTA_LIBRE"] },
          "response_value": { "type": ["string", "number", "null"] },
          "expected_value": { "type": ["string", "number", "null"] },
          "response_time_ms": { "type": "integer", "minimum": 0 },
          "score_weight": { "type": "number", "minimum": 0 },
          "scored_value": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
